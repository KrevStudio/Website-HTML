<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0a030a">
<title>KREV — Coming Soon</title>
<meta name="description" content="KREV. Luxury streetwear, built in the open. Join the list for early access.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Mono:wght@400;700&family=Inter:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --canvas-0: #050504;
    --canvas-1: #0d0b09;
    --bone: #F3EFEA;
    --bone-dim: rgba(243,239,234,.55);
    --bone-faint: rgba(243,239,234,.28);
    --accent: #E23E6B;
    --accent-dim: rgba(226,62,107,.4);
    --track: rgba(243,239,234,.1);
    --focus: #E23E6B;
    --safe-t: env(safe-area-inset-top, 0px);
    --safe-b: env(safe-area-inset-bottom, 0px);
    --safe-l: env(safe-area-inset-left, 0px);
    --safe-r: env(safe-area-inset-right, 0px);
  }

  *{ box-sizing: border-box; }
  html{ -webkit-text-size-adjust: 100%; background: var(--canvas-0); }

  body{
    margin:0;
    min-height: 100svh;
    min-height: 100dvh;
    background:
      radial-gradient(130% 65% at 50% -8%, rgba(226,62,107,.16) 0%, rgba(226,62,107,0) 55%),
      radial-gradient(100% 80% at 50% 25%, #2a0a17 0%, #170510 40%, var(--canvas-0) 100%);
    color: var(--bone);
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    overflow-x: hidden;
    position: relative;
    display:flex;
    flex-direction: column;
  }

  /* film grain — static tiled SVG noise, cheap on mobile GPUs */
  body::before{
    content:"";
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: .09;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='120' height='120'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>"),
      repeating-linear-gradient(0deg, rgba(0,0,0,.5) 0px, rgba(0,0,0,.5) 1px, transparent 1px, transparent 3px);
    background-size: 140px 140px, 100% 3px;
  }

  /* vignette */
  body::after{
    content:"";
    position: fixed;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    box-shadow: inset 0 0 20vw rgba(0,0,0,.75);
  }

  /* signature mark — the brand star, glowing behind the wordmark */
  .star-mark{
    position: absolute;
    top: 50%;
    left: 50%;
    width: clamp(200px, 54vw, 320px);
    height: auto;
    transform: translate(-50%, -46%);
    z-index: -1;
    opacity: .16;
    filter: drop-shadow(0 0 34px rgba(226,62,107,.55));
    pointer-events: none;
    display: block;
  }

  @media (prefers-reduced-motion: no-preference){
    .star-mark{ animation: drift 14s ease-in-out infinite; }
  }
  @keyframes drift{
    0%, 100%{ transform: translate(-50%, -46%) rotate(0deg); }
    50%{ transform: translate(-50%, -46%) rotate(4deg); }
  }

  /* slow-drifting smoke — two seamless-tiled layers for parallax depth */
  .smoke{
    position: fixed;
    inset: -10% -10%;
    z-index: 2;
    pointer-events: none;
    opacity: .09;
    mix-blend-mode: screen;
    background-image: url('smoke.png'), url('smoke.png');
    background-repeat: repeat, repeat;
    background-size: 900px 900px, 1300px 1300px;
    background-position: 0px 0px, 0px 0px;
    animation: smoke-drift 90s linear infinite;
  }

  @keyframes smoke-drift{
    from{ background-position: 0px 0px, 0px 0px; }
    to{ background-position: 900px 900px, -1300px 650px; }
  }

  @media (prefers-reduced-motion: reduce){
    .smoke{ animation: none; }
  }

  main{
    position: relative;
    z-index: 4;
    flex: 1;
    display:flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align:center;
    padding:
      calc(48px + var(--safe-t)) calc(22px + var(--safe-r)) 28px calc(22px + var(--safe-l));
    max-width: 560px;
    margin: 0 auto;
    width: 100%;
  }

  .eyebrow{
    font-family:'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: .28em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 18px;
    font-weight: 700;
  }

  .wordmark{
    font-family:'Bebas Neue', sans-serif;
    font-size: clamp(72px, 22vw, 140px);
    line-height: .82;
    letter-spacing: .05em;
    margin: 0;
    background: linear-gradient(180deg, #ffffff 0%, var(--bone) 45%, #cfc4c0 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-shadow: 0 0 70px rgba(226,62,107,.25);
    position: relative;
    z-index: 1;
  }

  .tagline{
    font-size: clamp(14px, 4vw, 17px);
    color: var(--bone-dim);
    margin: 14px 0 0;
    font-weight: 400;
    line-height: 1.5;
    max-width: 30ch;
  }

  /* progress readout — the signature element */
  .progress-block{
    width: 100%;
    max-width: 360px;
    margin: 40px 0 6px;
  }

  .progress-labels{
    display:flex;
    justify-content: space-between;
    font-family:'Space Mono', monospace;
    font-size: 10px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--bone-faint);
    margin-bottom: 8px;
  }

  .progress-labels .pct{
    color: var(--accent);
    font-weight: 700;
  }

  .progress-track{
    position: relative;
    height: 2px;
    background: var(--track);
    border-radius: 2px;
    overflow: visible;
  }

  .progress-fill{
    position: absolute;
    inset: 0 auto 0 0;
    width: 0%;
    background: linear-gradient(90deg, #7a1230, var(--accent));
    border-radius: 2px;
    transition: width 1.6s cubic-bezier(.22,.61,.36,1);
  }

  .progress-fill::after{
    content:"";
    position: absolute;
    right: -2px; top: 50%;
    width: 6px; height: 6px;
    background: var(--accent);
    border-radius: 50%;
    transform: translateY(-50%);
    box-shadow: 0 0 10px 2px var(--accent-dim);
  }

  .progress-note{
    font-family:'Space Mono', monospace;
    font-size: 10px;
    letter-spacing: .08em;
    color: var(--bone-faint);
    margin-top: 10px;
  }

  form{
    margin-top: 34px;
    width: 100%;
    max-width: 380px;
    display:flex;
    flex-direction: column;
    gap: 10px;
  }

  .field{ position: relative; }

  input[type="email"]{
    width: 100%;
    height: 50px;
    padding: 0 16px;
    background: rgba(243,239,234,.04);
    border: 1px solid rgba(243,239,234,.18);
    border-radius: 3px;
    font-family: 'Inter', sans-serif;
    font-size: 16px; /* prevents iOS auto-zoom on focus */
    color: var(--bone);
    outline: none;
    transition: border-color .2s ease, background .2s ease;
    -webkit-appearance: none;
    appearance: none;
  }
  input[type="email"]::placeholder{ color: var(--bone-faint); }
  input[type="email"]:focus{
    border-color: var(--accent-dim);
    background: rgba(243,239,234,.06);
  }
  input[type="email"]:focus-visible{
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  button{
    height: 50px;
    background: var(--bone);
    color: #1a0710;
    border: none;
    border-radius: 3px;
    font-family: 'Space Mono', monospace;
    font-size: 12px;
    letter-spacing: .14em;
    text-transform: uppercase;
    font-weight: 700;
    cursor: pointer;
    transition: transform .15s ease, background .2s ease;
    -webkit-tap-highlight-color: transparent;
  }
  button:hover{ background: #fff; }
  button:active{ transform: scale(.97); }
  button:disabled{ opacity: .6; cursor: default; }
  button:focus-visible{
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  @media (min-width: 480px){
    form{ flex-direction: row; }
    button{ flex: 0 0 auto; padding: 0 26px; }
    .field{ flex: 1; }
  }

  .msg{
    min-height: 18px;
    margin-top: 12px;
    font-family:'Space Mono', monospace;
    font-size: 12px;
  }
  .msg.error{ color: #e0785e; }
  .msg.success{ color: var(--accent); }

  .microcopy{
    font-size: 11px;
    color: var(--bone-faint);
    margin-top: 4px;
  }

  footer{
    position: relative;
    z-index: 4;
    text-align: center;
    padding: 20px 16px calc(24px + var(--safe-b));
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: .1em;
    color: var(--bone-faint);
  }

  footer .links{
    display:flex;
    justify-content:center;
    gap: 18px;
    margin-bottom: 10px;
    flex-wrap: wrap;
  }

  footer a{
    color: var(--bone-dim);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color .2s ease, border-color .2s ease;
  }
  footer a:hover{ color: var(--bone); border-color: var(--bone-faint); }
  footer a:focus-visible{ outline: 2px solid var(--focus); outline-offset: 2px; }

  @media (prefers-reduced-motion: reduce){
    .progress-fill{ transition: none; }
  }
</style>
</head>
<body>
  <div class="smoke" aria-hidden="true"></div>

  <main>
      
    <p class="eyebrow">Est. 2026 — Luxury Streetwear</p>
    <h1 class="wordmark">KREV</h1>
    <p class="tagline">We refuse average. The first collection is in progress — not a promise, a process.</p>

    <div class="progress-block">
      <div class="progress-labels">
        <span>Collection 001</span>
        <span class="pct"><span id="pct-num">0</span>% built</span>
      </div>
      <div class="progress-track">
        <div class="progress-fill" id="progress-fill"></div>
      </div>
      <p class="progress-note">Patterns cut. Fabric sourced. Fit in testing.</p>
    </div>

    <form id="notify-form" novalidate>
      <div class="field">
        <label for="email" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);">Email address</label>
        <input type="email" id="email" name="email" placeholder="you@email.com" required autocomplete="email" inputmode="email">
      </div>
      <button type="submit">Request access</button>
    </form>
    <p class="msg" id="form-msg" role="status" aria-live="polite"></p>
    <p class="microcopy">First access, first pairs. No spam — one email when we launch.</p>
  </main>

  <footer>
    <div class="links">
      <a href="https://instagram.com/krev.studio" target="_blank" rel="noopener">@krev.studio</a>
    </div>
    <p>&copy; 2026 KREV</p>
  </footer>

<script>
  // ---------------------------------------------------------------------
  // PROGRESS READOUT
  // Set this to whatever your real build progress is — it's the honesty
  // of this number that sells "built in the open." Update it as you go.
  // ---------------------------------------------------------------------
  const PROGRESS_PERCENT = 68;

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fill = document.getElementById('progress-fill');
  const pctNum = document.getElementById('pct-num');

  function animateProgress(){
    fill.style.width = PROGRESS_PERCENT + '%';
    if (prefersReducedMotion){
      pctNum.textContent = PROGRESS_PERCENT;
      return;
    }
    const duration = 1400;
    const start = performance.now();
    function tick(now){
      const t = Math.min(1, (now - start) / duration);
      const eased = 1 - Math.pow(1 - t, 3);
      pctNum.textContent = Math.round(eased * PROGRESS_PERCENT);
      if (t < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }
  requestAnimationFrame(() => requestAnimationFrame(animateProgress));

  // ---------------------------------------------------------------------
  // EMAIL CAPTURE
  // This demo stores signups in the browser (localStorage) so the page
  // works with zero setup. Emails will NOT reach you until you connect a
  // real backend. To do that, pick one:
  //
  //  1) Formspree (easiest): create a form at https://formspree.io,
  //     then set FORM_ENDPOINT below to your endpoint URL, e.g.
  //     'https://formspree.io/f/xxxxxxx', and set USE_REMOTE = true.
  //
  //  2) Mailchimp / ConvertKit / Klaviyo: replace the fetch call in
  //     submitEmail() with that provider's signup API or embed snippet.
  //
  //  3) Your own server: point FORM_ENDPOINT at your API route.
  // ---------------------------------------------------------------------
  const USE_REMOTE = true;
  const FORM_ENDPOINT = 'https://formspree.io/f/mnpazerb';

  const form = document.getElementById('notify-form');
  const emailInput = document.getElementById('email');
  const msg = document.getElementById('form-msg');

  function isValidEmail(value){
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
  }

  function setMsg(text, type){
    msg.textContent = text;
    msg.className = 'msg' + (type ? ' ' + type : '');
  }

  async function submitEmail(email){
    if (USE_REMOTE) {
      const res = await fetch(FORM_ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ email })
      });
      if (!res.ok) throw new Error('Request failed');
      return;
    }
    const list = JSON.parse(localStorage.getItem('krev_signups') || '[]');
    if (!list.includes(email)) list.push(email);
    localStorage.setItem('krev_signups', JSON.stringify(list));
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = emailInput.value.trim();

    if (!isValidEmail(email)) {
      setMsg('That doesn\u2019t look like a valid email — check it and try again.', 'error');
      emailInput.focus();
      return;
    }

    const button = form.querySelector('button');
    button.disabled = true;
    setMsg('Sending…');

    try {
      await submitEmail(email);
      form.reset();
      setMsg('You\u2019re in. Watch your inbox.', 'success');
    } catch (err) {
      setMsg('Something went wrong — try again in a moment.', 'error');
    } finally {
      button.disabled = false;
    }
  });
</script>

</body>
</html>
